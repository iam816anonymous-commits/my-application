# Automation OS — Environment Configuration Template
# Duplicate this file to .env before starting the servers.

# Global Environment Mode (development, testing, production)
NODE_ENV=development

# API Gateway Configuration
PORT=3000
GATEWAY_URL=http://localhost:3000

# Auth Service Settings
AUTH_SERVICE_PORT=3001
JWT_SECRET=super-secret-jwt-key-change-in-production-123!
JWT_EXPIRE_SECONDS=86400

# Automation Service (Database / Orchestration Core)
AUTOMATION_SERVICE_PORT=3002
SQLITE_DB_PATH=./data/automation-os.sqlite

# Artifact Storage Settings
ARTIFACT_SERVICE_PORT=3003
ARTIFACT_STORAGE_DIR=./data/artifacts
MAX_UPLOAD_SIZE_MB=50

# Worker and Queue Configurations (Redis Connection)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Policies Configuration
ALLOWED_BROWSER_DOMAINS=*.github.com,*.google.com,localhost
ALLOWED_FILE_DIRECTORIES=/tmp/automation-os,%USERPROFILE%/Downloads

# Execution Agent Registration Token
AGENT_REGISTRATION_TOKEN=agent-auth-shared-token-0987654321
