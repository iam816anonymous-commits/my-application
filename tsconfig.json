{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@automation-os/shared-types": ["packages/shared-types/src/index.ts"],
      "@automation-os/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@automation-os/config": ["packages/config/src/index.ts"],
      "@automation-os/event-contracts": ["packages/event-contracts/src/index.ts"],
      "@automation-os/testing": ["packages/testing/src/index.ts"]
    }
  },
  "references": [
    { "path": "packages/shared-types" },
    { "path": "packages/shared-utils" },
    { "path": "packages/config" },
    { "path": "packages/event-contracts" },
    { "path": "packages/testing" },
    { "path": "services/auth-service" }
  ]
}
