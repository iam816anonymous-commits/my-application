{
  "name": "automation-os",
  "version": "1.0.0",
  "description": "Automation OS - robust, local-first automation platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "workers/*",
    "adapters/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsx --test packages/*/tests/*.test.ts packages/*/tests/**/*.test.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.38.0",
    "prettier": "^2.8.8",
    "tsx": "^4.23.12",
    "typescript": "^5.0.4",
    "zod": "^3.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
